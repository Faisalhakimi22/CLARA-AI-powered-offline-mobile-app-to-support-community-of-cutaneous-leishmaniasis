    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@playwright/test": "^1.63.0",
    "@types/react": "~19.2.2",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "postinstall": "patch-package && node scripts/prepare-model-runtime.cjs",
    "build:android:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "preweb": "node scripts/prepare-model-runtime.cjs",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "preexport": "node scripts/prepare-model-runtime.cjs",
    "export": "expo export --platform all",
    "doctor": "npx expo-doctor",
    "format": "prettier --write App.tsx src scripts tests playwright.config.ts app.json package.json tsconfig.json README.md QA.md"
  },
  "private": true
}
